<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name= "viewport" content="width=device-width, initial-scale=1.0">
    <title>St. John's University - Tech Services & Products</title>
<style>
    body{
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 50px 80px;
        color: #111;
    }
    header {
        display: flex;
        align-items: center;
        margin-bottom: 120px;

    }
    .logo img{
        height: 130px;

    }
    nav ul {
        list-style: none;
        display: flex;
        gap: 60px;
        margin-left: 150px;
        padding: 0;
    }
    nav a {
        text-decoration: none;
        color: #111;
        font-size: 1.1rem;

    }
    .hero {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        margin-bottom: 60px;

    }
    
    .hero-content h1{
        font-size: 3.2rem;
        font-weight: 400;
        line-height: 1.1;
        margin: 0;
        max-width: 450px;
    }
    .hero-content p {
        font-size: 1.1rem;
        line-height: 1.5;
        margin: 0;
        max-width: 500px;
     
    }
    .hero-image {
        width: 45%;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }
    .hero-image img{
        width: 100%;
        height: 350px;
        object-fit: cover;
        margin-bottom: 20px;
    }
    .hero-content {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-bottom: 65px;

    }
    .btn {
        background-color: #f1f1f1;
        color: #111;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 30px;
        font-size: 0.95rem;
        display: inline-block;

    }
    .footer-columns {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: #555;

    }
    .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .footer-col p, .footer-col li {
        margin-bottom: 5px;

    }
    .footer-col a {
        text-decoration: none;
        color: #555;
    }
</style>
</head>
<body>

    <header>
    
        <div class ="logo">
            <img src="Images/St_Johns.png" alt="St. Johns University Logo">
        </div>
        <nav>
            <ul>
                <li><a href="#services">Services</a></li>
                <li><a href="#products">Products</a></li>
            </ul>
        </nav>
    </header>
    
    <main>

        <section class="hero">
            <div class="hero-content">
                <h1> We simplify technology so you can focus on growing your business.</h1>
                <p>Work with our 15+ years of experts from Oracle, Google, Meta, Amazon, IBM and academic institutions to grow your business.</p>
                            </div>
            <div class="hero-image">
                <img src="Images/hero-ship-workers.jpg" alt="Workers sitting on a ship">
              <a href="#schedule" class="btn">Schedule call with us</a>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-columns">
            <div class="footer-col location">
                <p>2 Terrace St, Oyster Bay<br> New York 11771, USA</p>
            </div>
        <div class="footer-col links">
            <ul>
                <li><a href="#">Who We Are</a></li>
                <li><a href="#">Publications</a></li>
            </ul>
        </div>
        <div class="footer-col links">
            <ul>
                <li><a href="#">Our mission</a></li>
                <li><a href="#">Our vision</a></li>
            </ul>
        </div>
        <div class="footer-col links">
            <ul>
                <li><a href="#">Career</a></li>
                <li><a href="#">Internnship</a></li>
            </ul>
        </div>
        <div class="footer-col contact">
            <p>(917) 222-2222<br><a href="mailtoLinfo@google.com">info@google.com</a></p>
        </div>
        </div>
    </footer>
</body>
</html>
